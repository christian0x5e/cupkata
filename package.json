{
  "name": "cupkata",
  "version": "0.1.0",
  "private": true,
  "description": "Cupkata - editeur video de bureau",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && cross-env CUPKATA_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true,
    "electron@45.2.1": true,
    "onnxruntime-node@1.30.0": true,
    "electron-winstaller@5.4.0": false
  },
  "author": "Cupkata",
  "build": {
    "appId": "local.cupkata.app",
    "productName": "Cupkata",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "ai/**",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
    ],
    "asarUnpack": [
      "ai/**",
      "shared/control-commands.json",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cupkata",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "artifactName": "Cupkata-Setup-${version}.exe"
    }
  }
}
